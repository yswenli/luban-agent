<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- TEMP-LOCAL-VERIFY: P0/P1/P2 开发期框架一律走项目引用，避免反复发本 nupkg；
		     三阶段全部验收后统一发最终版本包并还原为 PackageReference（见 P2 计划 Phase N） -->
		<ProjectReference Include="..\..\luban-framework\LuBan.AIAgent\LuBan.AIAgent.csproj" />
		<ProjectReference Include="..\..\luban-framework\LuBan.Common\LuBan.Common.csproj" />
		<ProjectReference Include="..\..\luban-framework\LuBan.DI\LuBan.DI.csproj" />
		<ProjectReference Include="..\..\luban-framework\LuBan.Threading\LuBan.Threading.csproj" />
		<ProjectReference Include="..\..\luban-framework\LuBan.Logging\LuBan.Logging.csproj" />
		<ProjectReference Include="..\..\luban-framework\LuBan.Orm\LuBan.Orm.csproj" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
	</ItemGroup>

	<!-- 嵌入模型包：单一来源，经 ProjectReference 内容传播带入每个引用方（Cli/Codex）的输出目录。
       运行期由 ModelManager.LocalZipPath 按 AppDomain.BaseDirectory/EmbeddingModels 解析。 -->
	<ItemGroup>
		<Content Include="EmbeddingModels\bge-small-zh-v1.5.zip">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>
</Project>