<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- framework：经 NuGet 私有源（用户级 NuGet.Config 的 nexus3）引用。
		     原 TEMP-LOCAL-VERIFY 项目引用已于 2026-10-20 三阶段验收后还原为包引用，版本统一 2026.10.20.1。
		     注意：改 framework 源码不再即时生效，需重新发包并提升此版本号。 -->
		<PackageReference Include="LuBan.AIAgent" Version="2026.10.20.1" />
		<PackageReference Include="LuBan.Common" Version="2026.10.20.1" />
		<PackageReference Include="LuBan.Logging" Version="2026.10.20.1" />
		<PackageReference Include="LuBan.Orm" Version="2026.10.20.1" />
		<!-- 产品侧厂商连接器（云效）已并入本程序集（Connectors/AliyunDevOps/），不再独立成程序集；
		     宿主仍显式注册（AgentHostBuilder → AddAliyunDevOpsConnector），ALC 回落语义不变。 -->
		<!-- Microsoft.Extensions.DependencyInjection / Options / Configuration / AI
		     不再显式声明：统一由 LuBan.AIAgent / Common / Logging 传递提供（10.0.13 / 10.11.0）。
		     显式钉低版本会触发 NU1605 包降级（NuGet 直接引用最近者优先）。 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
	</ItemGroup>

	<!-- 嵌入模型包：单一来源，经 ProjectReference 内容传播带入每个引用方（Cli/Codex）的输出目录。
       运行期由 ModelManager.LocalZipPath 按 AppDomain.BaseDirectory/EmbeddingModels 解析。 -->
	<ItemGroup>
		<Content Include="EmbeddingModels\bge-small-zh-v1.5.zip">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>
</Project>