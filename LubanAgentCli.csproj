<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>False</PublishAot>

		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>

		<StripSymbols>true</StripSymbols>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>

		<!-- 屏蔽语言包 -->
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<GenerateSatelliteAssemblies>false</GenerateSatelliteAssemblies>
		<UseResourceManifest>false</UseResourceManifest>
		<StartupObject>LubanAgent.Program</StartupObject>
		<ApplicationIcon>favicon.ico</ApplicationIcon>

		<!-- dotnet tool 全局安装支持 -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>luban-agent-cli</ToolCommandName>
		<PackageId>LuBan.Agent.CLI</PackageId>
		<PackageVersion>1.0.0</PackageVersion>
		<Authors>yswenli</Authors>
		<Description>LuBan AI Agent 命令行工具，支持多 Agent 编排、工具调用、会话管理</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
		<None Remove="EmbeddingModels\bge-small-zh-v1.5.zip" />
	</ItemGroup>

	<!-- 无头渲染快照工具，用于在无 TTY 环境下回归验证 TUI 布局 -->
	<ItemGroup>
		<InternalsVisibleTo Include="TuiSnapshot" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <Pack>true</Pack>
		  <PackagePath>tools/</PackagePath>
		</Content>
		<Content Include="favicon.ico" />
		<Content Include="EmbeddingModels\bge-small-zh-v1.5.zip">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\luban-framework\LuBan.AIAgent\LuBan.AIAgent.csproj" />
		<ProjectReference Include="..\luban-framework\LuBan.Logging\LuBan.Logging.csproj" />
		<ProjectReference Include="..\luban-framework\LuBan.Orm\LuBan.Orm.csproj" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
		<PackageReference Include="Terminal.Gui" Version="2.4.17" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<!-- OpenAI 版本必须满足 M.E.AI.OpenAI 10.9.0 的约束 (>=2.12.0 && <2.13.0)；
		     2.13.0 的流式工具调用表示有破坏性变更，会导致工具调用 chunk 解析为空 update、轮次静默结束 -->
		<PackageReference Include="OpenAI" Version="2.12.0" />
	</ItemGroup>
</Project>