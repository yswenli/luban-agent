# LubanAgentWebHost 运行期配置模板。
#
#   cp .env.example .env    # 首次；.env 已被 .gitignore 忽略，不要提交
#
# 这个文件同时干两件事：
#   1. compose 读它做 ${VAR} 插值（端口、镜像标签、宿主机项目目录）；
#   2. 通过 docker-compose.yml 的 env_file 整份注入容器。
# 值一律不加引号——compose 会剥引号而 `docker run --env-file` 不会，统一不加才能两边一致。

# ---------- 宿主侧（只影响 compose 插值）----------
# 镜像标签：build-image.ps1 默认打 latest
LUBAN_WEBHOST_TAG=latest
# 宿主机端口（容器内固定 18080）
LUBAN_WEBHOST_PORT=18080
# 要交给 Agent 读写的宿主机项目目录，映射到容器内 /data/projects。
# Windows 写 D:/work，Linux 写 /srv/work；留默认 ./workspace 时目录不存在会自动创建，
# 但 Linux 宿主上需保证容器用户（uid 1654）可写，否则先 chown。
LUBAN_WORKSPACE_HOST_DIR=./workspace

# ---------- 容器内路径 ----------
# 数据根：数据库、模型、仓库、工作区、JWT 密钥、插件都在这
LUBAN_AGENT_HOME=/data
# 框架级 ~/.luban-agent（skills/rules/mcps）与 git 凭据跟随 HOME；必须也是 /data 才随卷持久化
HOME=/data
TZ=Asia/Shanghai
# 滚动日志目录：默认是进程目录下的 logs（/app/logs），改到卷里才不怕重建
LuBanLoggingOptions__Directory=/data/logs
# 容器里只能靠 docker logs 看日志，而镜像内默认 EnableConsole=false，这里打开
LuBanLoggingOptions__EnableConsole=true

# ---------- 嵌入模型与脚本 ----------
# 镜像不带模型包（52 MB），首次启动按此地址下载到 /data/models/bge-small-zh-v1.5.zip 再解压。
# 内网/离线部署时留空即可：检索功能自动禁用，其余功能不受影响。
LuBanAgent__Tools__Retrieval__DownloadUrl=https://tejingcai.oss-cn-shanghai.aliyuncs.com/onnx/bge-small-zh-v1.5.zip
# RunPython 的解释器：Debian 只有 python3，没有 python
LuBanAgent__Tools__Script__PythonPath=python3

# ---------- 登录 ----------
# 留空则随机生成，只在首次启动日志里打印一次
LubanAgentWeb__AdminPassword=
# 容器内走 HTTP，TLS 交给外层反向代理；要启用容器内自签 HTTPS 见 README
LubanAgentWeb__UseHttps=false