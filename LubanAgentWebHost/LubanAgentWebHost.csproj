<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<RootNamespace>LubanAgentWebHost</RootNamespace>
		<AssemblyName>LubanAgentWebHost</AssemblyName>
		<StartupObject>LubanAgentWebHost.Program</StartupObject>
		<!-- 显示版本：顶栏、关于弹窗与 401 页都读程序集版本，改这里即全站生效 -->
		<Version>2.0.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<!-- SAEA.MVC 只按 /{controller}/{action} 派发，控制器必须与宿主同程序集 -->
		<PackageReference Include="SAEA.MVC" Version="26.10.8.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LubanAgentCore\LubanAgentCore.csproj" />
		<!-- A2A 运行时随宿主下沉：服务端/客户端角色都在 WebHost 进程内启停（实现已并入 LubanAgentCore） -->
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- 浏览器端静态站点：源码在 ../web，产物由 `npm run build` 落在此目录；构建时整体拷到输出目录的 wwwroot -->
		<Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
		<!-- 浏览器端「帮助」弹窗展示仓库 README：拷到输出根目录，由 /system/readme 读取 -->
		<Content Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<!-- README 的预览图用根目录相对路径，随站点一起放进 wwwroot -->
		<Content Include="..\lubanagent.png" Link="wwwroot\lubanagent.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\lubanagent-chat.png" Link="wwwroot\lubanagent-chat.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\lubanagent-settings.png" Link="wwwroot\lubanagent-settings.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\lubanagent-help.png" Link="wwwroot\lubanagent-help.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\lubanagent-about.png" Link="wwwroot\lubanagent-about.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>