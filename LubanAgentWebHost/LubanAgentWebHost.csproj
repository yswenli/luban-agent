<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<RootNamespace>LubanAgentWebHost</RootNamespace>
		<AssemblyName>LubanAgentWebHost</AssemblyName>
		<StartupObject>LubanAgentWebHost.Program</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<!-- SAEA.MVC 只按 /{controller}/{action} 派发，控制器必须与宿主同程序集 -->
		<PackageReference Include="SAEA.MVC" Version="26.10.8.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LubanAgentCore\LubanAgentCore.csproj" />
		<ProjectReference Include="..\LubanAgentProtocol\LubanAgentProtocol.csproj" />
		<!-- A2A 运行时随宿主下沉：服务端/客户端角色都在 WebHost 进程内启停 -->
		<ProjectReference Include="..\LubanAgentA2A\LubanAgentA2A.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>