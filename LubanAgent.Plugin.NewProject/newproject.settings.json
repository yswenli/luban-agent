// 「新建项目」插件配置（包内默认值）。
// 允许 // 行注释。宿主配置节点可覆盖同名项（P2 起接入）。
//
// 【真机联调后可调的四项】
//   ① templates[].branch —— 模板 pin 的**可选覆盖**（分支 / 标签）。留空＝运行期实时解析：
//      在模板仓现有分支里按 develop → master → main → 模板默认分支 取第一个存在的，
//      并把「取到了哪个、为什么」回显在 Step 3 预检里（无需人工登记即可跑通）。
//      登记了值则必须真实存在，否则 Step 3 预检直接阻断（不静默回退）。
//   ② templates[].projectId —— 可选的模板仓 ID 覆盖（整数，留空则按 repository 名在**模板库**中匹配）。
//   ③ groupNameFormat / groupParentId —— 运行期自动建的项目代码组名格式与父级组 ID；
//      groupParentId 留空＝建在组织根下（云效：parentId 空即在组织路径下创建）。
//   ④ pipelineReferences[].pipelineId —— Step 7 参考流水线，P5 前填入。
{
  "defaultVisibility": "internal",

  // Step 6 推送目标分支：本组织口径为 develop（v0.28 起；PRD §6 #17 定案改口径）。
  // 理由：Step 3 克隆的 pin 按 develop → master → main 择优（NewProjectService.PreferredPins），
  //      各端仓库实际都落在 develop；推送分支若仍取 main 就成了「在 develop 编译、推 main」。
  // 该值同时用作云效建仓的默认分支，故 Step 3 建仓与 Step 6 推送两处口径一致。
  // 留空则退回各端仓库的默认分支（仍为空则 main）。
  "pushBranch": "develop",
  "repositoryNameFormat": "{code}-{end}",

  // 项目代码组名格式（{code}/{Code}/{CODE}/{name}）；默认全大写缩写，如 jnms → JNMS。
  // 该名字先在组织内查、命中即复用、未命中才创建；同时用作云效 path，勿含 "/"。
  "groupNameFormat": "{CODE}",

  // 代码组父级组 ID（可选，整数）：留空＝直接建在组织根下（如 tjc 下）
  "groupParentId": "",

  // Step 6 提交身份兜底（F5=A）：优先读本机 git config user.name/user.email，缺失时用这里的值
  "commitAuthorName": "LuBan Agent",
  "commitAuthorEmail": "luban-agent@local",

  // 占位符替换规则（F3=A）：字面量、区分大小写；From 为空或 To 展开后为空的规则会被丢弃。
  // To 支持令牌：{code} 缩写原文 / {Code} 首字母大写 / {CODE} 全大写 / {name} 项目中文名。
  // 留空则使用内置默认（TJCES / Tjces / tjces 三种大小写变体）。
  "placeholderRules": [
    { "from": "TJCES", "to": "{CODE}" },
    { "from": "Tjces", "to": "{Code}" },
    { "from": "tjces", "to": "{code}" }
  ],

  "templates": [
    // 后端：以 TJCES-Service 为模板（PRD §4.5）；branch 留空＝运行期解析 pin
    { "end": "Service", "repository": "TJCES-Service", "branch": "", "projectId": "" },
    // 管理端：以 TJCES-Admin 为模板
    { "end": "Admin", "repository": "TJCES-Admin", "branch": "", "projectId": "" },
    // 移动端：以 TJCES-Mobile 为模板（仅当 Step 1 勾选时才参与）
    { "end": "Mobile", "repository": "TJCES-Mobile", "branch": "", "projectId": "" }
  ],
  "pipelineReferences": [
    // 企服版三端参考流水线标识（Step 7 克隆来源）
    { "end": "Service", "pipelineId": "" },
    { "end": "Admin", "pipelineId": "" },
    { "end": "Mobile", "pipelineId": "" }
  ]
}