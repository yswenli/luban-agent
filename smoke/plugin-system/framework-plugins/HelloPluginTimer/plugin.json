    {
      "id": "hello",
      "label": "冒烟",
      "icon": "project",
      "panelType": "HelloPluginTimer.TimerPanel"
    }
  ],
  "skills": [
    {
      "id": "hello-manifest-skill",
      "name": "清单技能",
      "description": "由 plugin.json 声明"
    }
