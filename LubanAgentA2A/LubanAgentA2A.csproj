<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- A2A 协议 SDK（core + ASP.NET Core 宿主）；均 net10.0/net8.0，实依赖 M.E.AI.Abstractions 可被 AIAgent 覆盖 -->
	<ItemGroup>
		<PackageReference Include="A2A" Version="1.0.0-preview2" />
		<PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview2" />
		<PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
	</ItemGroup>

	<!-- A2A Server 宿主：基于 ASP.NET Core（仅库引用，不启用 Generic Host） -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LubanAgentCore\LubanAgentCore.csproj" />
		<!-- TEMP-LOCAL-VERIFY: P0/P1/P2 开发期框架走项目引用，避免反复发本 nupkg；
		     三阶段全部验收后统一发最终版本包并还原为 PackageReference（见 P2 计划 Phase N） -->
		<ProjectReference Include="..\..\luban-framework\LuBan.AIAgent\LuBan.AIAgent.csproj" />
	</ItemGroup>
</Project>