<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- A2A 协议 SDK（core + ASP.NET Core 宿主）；均 net10.0/net8.0，实依赖 M.E.AI.Abstractions 可被 AIAgent 覆盖 -->
	<ItemGroup>
		<PackageReference Include="A2A" Version="1.0.0-preview2" />
		<PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview2" />
		<PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
	</ItemGroup>

	<!-- A2A Server 宿主：基于 ASP.NET Core（仅库引用，不启用 Generic Host） -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LubanAgentCore\LubanAgentCore.csproj" />
		<ProjectReference Include="..\LubanAgentProtocol\LubanAgentProtocol.csproj" />
		<!-- 框架包走 nexus3 私有源，版本人工控制；2026-10-29 曾临时直连 framework 源码，
		     2026.11.2.1 发包后已还原为 PackageReference。 -->
		<PackageReference Include="LuBan.AIAgent" Version="2026.11.2.1" />
	</ItemGroup>
</Project>