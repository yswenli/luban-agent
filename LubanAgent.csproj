<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>False</PublishAot>

		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>

		<StripSymbols>true</StripSymbols>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>

		<!-- 屏蔽语言包 -->
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<GenerateSatelliteAssemblies>false</GenerateSatelliteAssemblies>
		<UseResourceManifest>false</UseResourceManifest>
		<StartupObject>LubanAgent.Program</StartupObject>
		<ApplicationIcon>favicon.ico</ApplicationIcon>

		<!-- dotnet tool 全局安装支持 -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>luban-agent-cli</ToolCommandName>
		<PackageId>LuBan.Agent.CLI</PackageId>
		<PackageVersion>1.0.0</PackageVersion>
		<Authors>yswenli</Authors>
		<Description>LuBan AI Agent 命令行工具，支持多 Agent 编排、工具调用、会话管理</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Model\bge-small-zh-v1.5.zip" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="favicon.ico" />
		<Content Include="Model\bge-small-zh-v1.5.zip">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LuBan.AIAgent" Version="2026.8.4.1" />
		<PackageReference Include="LuBan.Logging" Version="2026.8.4.1" />
		<PackageReference Include="LuBan.Orm" Version="2026.8.4.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<PackageReference Include="OpenAI" Version="2.12.0" />
	</ItemGroup>


	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>tools/</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="System.Security.Cryptography.Xml" Version="10.0.10" />
	</ItemGroup>

</Project>