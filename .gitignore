################################################################################
# 此 .gitignore 文件已由 Microsoft(R) Visual Studio 自动创建。
################################################################################

/.vs
/.luban-agent
.worktrees/

# 构建产物：按项目整体忽略（覆盖 Debug/Release、netX.Y 与 RID 子目录）
/LubanAgentCodex/bin/
/LubanAgentCodex/obj/
/LubanAgentCli/bin/
/LubanAgentCli/obj/
/LubanAgentCore/bin/
/LubanAgentCore/obj/
/LubanAgent.Plugin.NewProject/bin/
/LubanAgent.Plugin.NewProject/obj/
/LubanAgent.Tests/bin/
/LubanAgent.Tests/obj/
/LubanAgentWebHost/bin/
/LubanAgentWebHost/obj/

# 冒烟资产（smoke/plugin-system）：工程构建产物与生成的插件包
/smoke/plugin-system/**/bin/
/smoke/plugin-system/**/obj/
/smoke/plugin-system/artifacts/

# 浏览器端前端（LubanAgentWebHost/web/）：依赖与本地构建中间产物
/LubanAgentWebHost/web/node_modules/
/LubanAgentWebHost/web/dist/

# 运行时生成的静态配置（含令牌），不进仓库
/LubanAgentWebHost/wwwroot/runtime-config.js
