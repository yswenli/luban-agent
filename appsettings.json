{
  "LuBanAgent": {
    "DefaultModel": "openai:gpt-4o",
    "SystemPrompt": "你是一个智能助手，可以帮助用户完成各种任务。",
    "Description": "LuBan AI Agent Console App",
    "MaxToolLoopIterations": 10,
    "Session": {
      "CompactTargetMessages": 50,
      "CompactThreshold": 10
    },
    "Tools": {
      "Browser": {
        "Enabled": true,
        "Headless": false,
        "Timeout": 30000,
        "Engine": "chromium"
      },
      "FileSystem": {
        "Enabled": true,
        "AllowedRoots": []
      },
      "Script": {
        "Enabled": true,
        "Shell": "cmd",
        "DefaultTimeout": 30000
      },
      "Database": {
        "Enabled": true
      },
      "Redis": {
        "Enabled": true
      },
      "Web": {
        "Enabled": true
      },
      "Retrieval": {
        "Enabled": true,
        "ModelId": "bge-small-zh-v1.5",
        "AutoDownload": true,
        "MaxFileSizeKB": 5120,
        "DefaultTopK": 5,
        "MaxResultChars": 8000
      }
    },
    "Orchestration": {
      "Enabled": true,
      "PlannerType": "Composite",
      "ExposeAsTool": true,
      "MaxParallelism": 3,
      "MaxNodes": 20,
      "DefaultNodeTimeoutSeconds": 120
    },
    "Providers": {
      "kimi": {
        "DisplayName": "Kimi (Moonshot)",
        "Endpoints": [
          { "Url": "https://api.moonshot.cn/v1", "Description": "国内通用 (推荐)" },
          { "Url": "https://api.moonshot.ai/v1", "Description": "海外直连" },
          { "Url": "https://api.kimi.com/coding/v1", "Description": "编程专属" }
        ],
        "Models": []
      },
      "minimax": {
        "DisplayName": "MiniMax",
        "Endpoints": [
          { "Url": "https://api.minimax.chat/v1", "Description": "国内通用 (推荐)" },
          { "Url": "https://api.minimaxi.chat/v1", "Description": "海外" }
        ],
        "Models": [
          "abab6.5s-chat",
          "abab6.5-chat",
          "abab6-chat",
          "abab5.5-chat"
        ]
      },
      "ark": {
        "DisplayName": "字节方舟 (火山引擎)",
        "Endpoints": [
          { "Url": "https://ark.cn-beijing.volces.com/api/v3", "Description": "默认" }
        ],
        "Models": [
          "doubao-pro-32k",
          "doubao-pro-128k",
          "doubao-lite-32k",
          "doubao-lite-128k"
        ]
      },
      "bailian": {
        "DisplayName": "阿里百炼",
        "Endpoints": [
          { "Url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "Description": "默认" }
        ],
        "Models": [
          "qwen-turbo",
          "qwen-plus",
          "qwen-max",
          "qwen-max-longcontext",
          "qwen2.5-72b-instruct",
          "qwen2.5-32b-instruct"
        ]
      },
      "hunyuan": {
        "DisplayName": "腾讯混元",
        "Endpoints": [
          { "Url": "https://api.hunyuan.cloud.tencent.com/v1", "Description": "默认" }
        ],
        "Models": [
          "hunyuan-pro",
          "hunyuan-standard",
          "hunyuan-lite",
          "hunyuan-turbo"
        ]
      },
      "mimo": {
        "DisplayName": "小米 MiMo",
        "Endpoints": [
          { "Url": "https://api.xiaomi.com/v1", "Description": "默认" }
        ],
        "Models": [
          "mimo-v1",
          "mimo-v1-32k",
          "mimo-v1-128k"
        ]
      }
    }
  },
  "DbConnectionOptions": {
    "EnableConsoleSql": false,
    "EnableDBLogs": false,
    "ConnectionConfigs": [
      {
        "ConfigId": "1300000000001",
        "DbType": "Sqlite",
        "ConnectionString": "Data Source=./luban-ai-agent.db",
        "DbSettings": {
          "EnableInitDb": true,
          "EnableDiffLog": false,
          "EnableUnderLine": true
        },
        "TableSettings": {
          "EnableInitTable": true,
          "EnableIncreTable": false
        },
        "SeedSettings": {
          "EnableInitSeed": true,
          "EnableIncreSeed": false
        }
      }
    ]
  },
  "SnowId": {
    "WorkerId": 1, // 机器码 全局唯一
    "WorkerIdBitLength": 1, // 机器码位长 默认值6，取值范围 [1, 19]
    "SeqBitLength": 6 // 序列数位长 默认值6，取值范围 [3, 21]（建议不小于4，值越大性能越高、Id位数也更长）
  }
}