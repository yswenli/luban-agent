{
  "LuBanLoggingOptions": {
    "Enabled": true,
    "Directory": "logs",
    "MaxFileSizeMB": 100,
    "MaxRollBackups": 5,
    "EnableConsole": false,
    "EnableDb": false,
    "Categories": {
      "loginfo": true,
      "logdebug": true,
      "logwarn": true,
      "logerror": true,
      "logcall": true
    }
  },
  "LuBanAgent": {
    "DefaultModel": "openai:gpt-4o",
    "SystemPrompt": "你是一个智能助手，可以帮助用户完成各种任务。",
    "Description": "LuBan AI Agent Console App",
    "MaxToolLoopIterations": 30,
    "Session": {
      "CompactTargetMessages": 50,
      "CompactThreshold": 10
    },
    "BaseBehavior": "",
    "Tools": {
      "Browser": {
        "Enabled": true,
        "Headless": false,
        "Timeout": 30000,
        "Engine": "chromium"
      },
      "FileSystem": {
        "Enabled": true
      },
      "Script": {
        "Enabled": true,
        "Shell": "cmd",
        "DefaultTimeout": 30000
      },
      "Database": {
        "Enabled": true
      },
      "Redis": {
        "Enabled": true
      },
      "Web": {
        "Enabled": true
      },
      "Retrieval": {
        "Enabled": true,
        "ModelId": "bge-small-zh-v1.5",
        "AutoDownload": true,
        "MaxFileSizeKB": 5120,
        "DefaultTopK": 5,
        "MaxResultChars": 8000
      },
      "LocalMemory": {
        "Enabled": true,
        "DefaultTopK": 5,
        "FallbackDimension": 256,
        "TtlDays": null,
        "RecallEnabled": true,
        "RecallTopK": 3,
        "RecallMinScore": 0.3
      }
    },
    "Orchestration": {
      "Enabled": true,
      "PlannerType": "Composite",
      "ExposeAsTool": false,
      "AutoDetect": true,
      "MaxParallelism": 3,
      "MaxNodes": 20,
      "DefaultNodeTimeoutSeconds": 120,
      "HeuristicFilter": {
        "Enabled": true,
        "MaxLength": 20,
        "Keywords": [ "和", "同时", "然后", "并且", "另外", "还有", "分析并", "搜索并" ]
      }
    },
    "Providers": {
      "kimi": {
        "DisplayName": "Kimi (Moonshot)",
        "Endpoints": [
          { "Url": "https://api.moonshot.cn/v1", "Description": "国内通用 (推荐)" },
          { "Url": "https://api.moonshot.ai/v1", "Description": "海外直连" },
          { "Url": "https://api.kimi.com/coding/v1", "Description": "编程专属" }
        ],
        "Models": []
      },
      "minimax": {
        "DisplayName": "MiniMax",
        "Endpoints": [
          { "Url": "https://api.minimax.chat/v1", "Description": "国内通用 (推荐)" },
          { "Url": "https://api.minimaxi.chat/v1", "Description": "海外" }
        ],
        "Models": [
          "abab6.5s-chat",
          "abab6.5-chat",
          "abab6-chat",
          "abab5.5-chat"
        ]
      },
      "ark": {
        "DisplayName": "字节方舟 (火山引擎)",
        "Endpoints": [
          { "Url": "https://ark.cn-beijing.volces.com/api/v3", "Description": "默认" }
        ],
        "Models": [
          "doubao-pro-32k",
          "doubao-pro-128k",
          "doubao-lite-32k",
          "doubao-lite-128k"
        ]
      },
      "bailian": {
        "DisplayName": "阿里百炼",
