{
  "LuBanAgent": {
    "DefaultModel": "openai:gpt-4o",
    "SystemPrompt": "你是一个智能助手，可以帮助用户完成各种任务。",
    "Description": "LuBan AI Agent Console App",
    "MaxToolLoopIterations": 10,
    "Session": {
      "CompactTargetMessages": 50,
      "CompactThreshold": 10
    },
    "Tools": {
      "Browser": {
        "Enabled": true,
        "Headless": false,
        "Timeout": 30000,
        "Engine": "chromium"
      },
      "FileSystem": {
        "Enabled": true,
        "AllowedRoots": []
      },
      "Script": {
        "Enabled": true,
        "Shell": "cmd",
        "DefaultTimeout": 30000
      },
      "Database": {
        "Enabled": true
      },
      "Redis": {
        "Enabled": true
      },
      "Web": {
        "Enabled": true
      },
      "Retrieval": {
        "Enabled": true,
        "ModelId": "bge-small-zh-v1.5",
        "AutoDownload": true,
        "MaxFileSizeKB": 5120,
        "DefaultTopK": 5,
        "MaxResultChars": 8000
      }
    },
    "Orchestration": {
      "Enabled": true,
      "PlannerType": "Composite",
      "ExposeAsTool": true,
      "MaxParallelism": 3,
      "MaxNodes": 20,
      "DefaultNodeTimeoutSeconds": 120
    }
  },
  "DbConnectionOptions": {
    "EnableConsoleSql": false,
    "EnableDBLogs": false,
    "ConnectionConfigs": [
      {
        "ConfigId": "1300000000001",
        "DbType": "Sqlite",
        "ConnectionString": "Data Source=./luban-ai-agent.db",
        "DbSettings": {
          "EnableInitDb": true,
          "EnableDiffLog": false,
          "EnableUnderLine": true
        },
        "TableSettings": {
          "EnableInitTable": true,
          "EnableIncreTable": false
        },
        "SeedSettings": {
          "EnableInitSeed": true,
          "EnableIncreSeed": false
        }
      }
    ]
  },
  "SnowId": {
    "WorkerId": 1, // 机器码 全局唯一
    "WorkerIdBitLength": 1, // 机器码位长 默认值6，取值范围 [1, 19]
    "SeqBitLength": 6 // 序列数位长 默认值6，取值范围 [3, 21]（建议不小于4，值越大性能越高、Id位数也更长）
  }
}