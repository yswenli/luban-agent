<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<RootNamespace>LubanAgent.Client</RootNamespace>
		<AssemblyName>LubanAgentClient</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!-- 客户端侧需要 Agent 宿主的接口与模型（IAgentHost / ISessionManager / IWorkspaceManager），
		     以及工作区模型（WorkspaceInfo / WorkspaceTypes）所在的产品程序集 -->
		<ProjectReference Include="..\LubanAgentCore\LubanAgentCore.csproj" />
		<ProjectReference Include="..\LubanAgentProtocol\LubanAgentProtocol.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 测试工程需要验证子进程参数装配（BuildArguments），不对外暴露 -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>LubanAgent.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>