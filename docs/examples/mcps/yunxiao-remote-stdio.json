{
  "name": "yunxiao-remote-stdio",
  "description": "阿里云云效官方 MCP（stdio 子进程；需要本机 Node/npx；PAT 走凭据引用，无明文）",
  "transport": "stdio",
  "command": "npx",
  "args": [ "-y", "alibabacloud-devops-mcp-server" ],
  "environment": {
    "YUNXIAO_ACCESS_TOKEN": "$credential:connector:yunxiao:token"
  },
  "enabled": false
}