<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LubanAgentCodex.Views.Controls"
        x:Class="LubanAgentCodex.Views.MainWindow"
        Title="LubanCodex"
        Width="920"
        Height="670"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid RowDefinitions="*,Auto">

        <!-- 主内容区：侧边栏 + (消息流 + 输入框) -->
        <Grid Grid.Row="0" ColumnDefinitions="280,*">
            <controls:Sidebar Grid.Column="0"
                              x:Name="Sidebar" />

            <!-- 右侧：消息流 + 输入框 -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <controls:MessageStream Grid.Row="0"
                                        x:Name="MessageStream" />
                <controls:InputBox Grid.Row="1"
                                   x:Name="InputBox" />
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <controls:FooterBar Grid.Row="1"
                            x:Name="FooterBar" />

        <!-- 切换会话中央加载提示 -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              x:Name="LoadingOverlay"
              IsVisible="False"
              Background="#80000000"
              ZIndex="100">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="30,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Vertical"
                            Spacing="14"
                            HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="180"
                                 Height="4" />
                    <TextBlock Text="正在切换会话…"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</Window>
