<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LubanAgentCodex.Views.Controls.ToolCallCard">

    <UserControl.Styles>
        <!-- 参数折叠标题：30px 无壳按钮，去掉 Fluent 默认边框/背景 -->
        <Style Selector="Button#ArgumentsToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Button#ArgumentsToggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <!-- 图标按钮：去掉 Fluent 默认边框/背景 -->
        <Style Selector="Button#CopyButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Button#CopyButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Name="RootBorder"
            Margin="0,8"
            Background="{DynamicResource CardBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="0"
            HorizontalAlignment="Left"
            MaxWidth="560">
        <Grid ColumnDefinitions="3,*">
            <!-- 左侧色条：运行中黄/完成绿/失败红 -->
            <Border Name="AccentBar"
                    Grid.Column="0"
                    Background="{DynamicResource InfoBrush}"
                    CornerRadius="8,0,0,8" />
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,Auto,Auto"
                  Margin="12,10">
                <!-- 标题行：状态图标 + 工具图标 + 工具名 + 状态 + 复制 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock Name="StatusIcon"
                               Grid.Column="0"
                               Text="⏳"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="14" />
                    <TextBlock Name="ToolIcon"
                               Grid.Column="1"
                               Text="🔧"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="14" />
                    <TextBlock Name="ToolNameText"
                               Grid.Column="2"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="StateText"
                               Grid.Column="3"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="12" />
                    <Button Name="CopyButton"
                            Grid.Column="4"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="OnCopyClick"
                            IsVisible="False">
                        <TextBlock Text="📋" FontSize="13" />
                    </Button>
                </Grid>

                <!-- 结果摘要（仅有内容时显示） -->
                <Border Name="ResultSummaryBorder"
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        Padding="8,4"
                        Background="{DynamicResource SidebarBrush}"
                        CornerRadius="4"
                        IsVisible="False">
                    <TextBlock Name="ResultSummaryText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 参数（折叠）：自定义 30px 标题行，避免 Fluent Expander 自带壳 -->
                <Grid Name="ArgumentsSection"
                      Grid.Row="2"
                      Margin="0,4,0,0"
                      RowDefinitions="Auto,Auto"
                      IsVisible="False">
                    <Button Name="ArgumentsToggle"
                            Grid.Row="0"
                            Height="30"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            Click="OnArgumentsToggleClick">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Name="ArgumentsChevron"
                                       Text="▸"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="查看参数"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBox Name="ArgumentsText"
                             Grid.Row="1"
                             IsVisible="False"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas,Menlo,monospace"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             MaxHeight="160"
                             Margin="0,4,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>

</UserControl>
