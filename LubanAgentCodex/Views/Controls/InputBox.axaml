<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LubanAgentCore.Models;assembly=LubanAgentCore"
             xmlns:conv="using:LubanAgentCodex.Converters"
             x:Class="LubanAgentCodex.Views.Controls.InputBox">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12,24,16">
        <Grid RowDefinitions="Auto,Auto,Auto">

            <!-- 第 0 行：待发送附件条（有附件时由 MainWindow 显示） -->
            <ItemsControl Grid.Row="0" Name="AttachmentBar" Margin="0,0,0,8" IsVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AttachmentDisplayInfo">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6,3"
                                Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="32" Height="32"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SidebarBrush}"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <!-- 图片：缩略图 -->
                                        <Image Source="{Binding ThumbnailPath, Converter={x:Static conv:ThumbnailPathConverter.Instance}}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding IsImage}" />
                                        <!-- 非图片或无缩略图：文件图标 -->
                                        <TextBlock Text="📄"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsImage}" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="11"
                                               MaxWidth="140"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding FileSize, Converter={x:Static conv:FileSizeConverter.Instance}}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <Button Content="✕"
                                        FontSize="10"
                                        Padding="2,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Click="OnRemoveAttachmentClick" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 第一行：输入框 + 发送按钮 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12">
                    <TextBox Name="InputTextBox"
                             PlaceholderText="输入你的问题或指令...（Enter 发送，Ctrl+Enter 换行）"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MinHeight="36"
                             MaxHeight="100"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <Button Grid.Column="1"
                        Name="SendButton"
                        Content="➤"
                        FontSize="18"
                        MinWidth="48"
                        MinHeight="48"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        CornerRadius="12"
                        Margin="12,0,0,0"
                        Cursor="Hand"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
            </Grid>

            <!-- 第二行：工具栏 -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0"
                        Name="AttachButton"
                        Content="📎 附件"
                        ToolTip.Tip="选择附件（也可拖拽文件到窗口 / Ctrl+V 粘贴）"
                        FontSize="12"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Cursor="Hand"
                        Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Name="PermissionButton"
                        Content="⚡ 权限模式"
                        FontSize="12"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Cursor="Hand"
                        Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Name="StatsButton"
                        Content="📊 统计"
                        FontSize="12"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Cursor="Hand" />
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <TextBlock Name="ProcessingHint"
                               Text=" AI 正在处理..."
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               IsVisible="False" />
                    <ComboBox Name="ModelCombo"
                              MinWidth="120"
                              FontSize="12"
                              Background="{DynamicResource CardBrush}"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>

</UserControl>
