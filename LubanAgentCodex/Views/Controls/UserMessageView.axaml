<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LubanAgentCodex.ViewModels.Messages"
             xmlns:models="clr-namespace:LubanAgentCore.Models;assembly=LubanAgentCore"
             xmlns:conv="using:LubanAgentCodex.Converters"
             x:Class="LubanAgentCodex.Views.Controls.UserMessageView"
             x:DataType="vm:UserMessageItem">

    <StackPanel HorizontalAlignment="Right" Margin="0,8">
        <Border BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10"
                Background="Transparent"
                MaxWidth="500">
            <StackPanel>
                <TextBox Text="{Binding Content}"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap"
                         FontSize="14" />
                <ItemsControl ItemsSource="{Binding Attachments}"
                             IsVisible="{Binding HasAttachments}"
                             Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AttachmentDisplayInfo">
                            <StackPanel Margin="0,0,8,8" MaxWidth="180">
                                <!-- 图片：缩略图（点击查看大图） -->
                                <Border Width="120" Height="120"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SidebarBrush}"
                                        IsVisible="{Binding IsImage}"
                                        Cursor="Hand"
                                        PointerPressed="OnAttachmentPressed">
                                    <Grid>
                                        <TextBlock Text="📄"
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding ThumbnailPath, Converter={x:Static conv:ThumbnailPathConverter.Instance}}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <!-- 文本文件 / 历史无缩略图：文件芯片 -->
                                <Border Background="{DynamicResource CardBrush}"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        IsVisible="{Binding !IsImage}">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding FileName}" />
                                </Border>
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="10"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding TimeText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Right"
                   Margin="0,4,4,0" />
    </StackPanel>

</UserControl>
