<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LubanAgentCodex.Views.Controls"
             x:Class="LubanAgentCodex.Views.Controls.Sidebar">

    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto">

            <!-- 工作区 + 会话列表 -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="WorkspacePanel" />
            </ScrollViewer>

            <!-- 分隔线 -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="16,8" />

            <!-- LLM Wiki 知识库 -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <ListBox Name="LlmWikiListBox"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:LlmWikiRowModel">
                            <Border Padding="6,4" CornerRadius="4" Cursor="Hand"
                                    BorderThickness="0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0"
                                              Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"
                                              Width="12" Height="12"
                                              Margin="0,0,8,0"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Name="DeleteLlmWikiBtn"
                                            Padding="4,2"
                                            Margin="4,0,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="删除知识库"
                                            VerticalAlignment="Center">
                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                  Width="14" Height="14"
                                                  Foreground="#C62828"
                                                  VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- 插件贡献的侧栏入口（PRD §3.2 uiContributions）：无贡献时整块隐藏 -->
            <StackPanel Grid.Row="3" Name="PluginSection" Margin="0,8,0,0" IsVisible="False">
                <TextBlock Text="插件"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="16,0,0,4"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <ListBox Name="PluginEntryListBox"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:PluginSidebarRowModel">
                            <Border Padding="6,4" CornerRadius="4" Cursor="Hand" BorderThickness="0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0"
                                              Data="M20.5 11H19V7a2 2 0 0 0-2-2h-4V3.5a2.5 2.5 0 0 0-5 0V5H4a2 2 0 0 0-2 2v3.8h1.5a2.7 2.7 0 0 1 0 5.4H2V20a2 2 0 0 0 2 2h3.8v-1.5a2.7 2.7 0 0 1 5.4 0V22H16a2 2 0 0 0 2-2v-4h1.5a2.5 2.5 0 0 0 0-5z"
                                              Width="12" Height="12"
                                              Margin="0,0,8,0"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- 分隔线 -->
            <Border Grid.Row="4" Height="1" Background="{DynamicResource DividerBrush}" Margin="16,8" />

            <!-- 底部项目信息 -->
            <Border Grid.Row="5" Padding="16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text=" LubanAgentCodex"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="v1.0.0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- GitHub 仓库链接：点击在默认浏览器打开 -->
                    <Button Name="GitHubBtn"
                            Content="GitHub ↗"
                            FontSize="11"
                            Padding="0"
                            Margin="0,0,0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Cursor="Hand"
                            ToolTip.Tip="在浏览器中打开 GitHub 仓库" />
                    <TextBlock Text="Author: yswenli"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="yswenli@outlook.com"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="© 2026 All Rights Reserved"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <!-- 工作区设置中心入口：编辑当前/其它工作区及用户级 .luban-agent 的 skills/rules/mcps -->
                    <Button Name="SettingsBtn"
                            FontSize="12"
                            Padding="8,6"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            ToolTip.Tip="工作区设置（技能 / 规则 / MCP）">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                      Width="14" Height="14"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 插件管理入口（应用级插件，PRD §3.9） -->
                    <Button Name="PluginManageBtn"
                            FontSize="12"
                            Padding="8,6"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            ToolTip.Tip="插件管理（安装 / 启用 / 升级 / 卸载）">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="M20.5 11H19V7a2 2 0 0 0-2-2h-4V3.5a2.5 2.5 0 0 0-5 0V5H4a2 2 0 0 0-2 2v3.8h1.5a2.7 2.7 0 0 1 0 5.4H2V20a2 2 0 0 0 2 2h3.8v-1.5a2.7 2.7 0 0 1 5.4 0V22H16a2 2 0 0 0 2-2v-4h1.5a2.5 2.5 0 0 0 0-5z"
                                      Width="14" Height="14"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="插件" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
