<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LubanAgentCodex.Views.Controls"
             x:Class="LubanAgentCodex.Views.Controls.Sidebar">

    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto,Auto,Auto,Auto">

            <!-- 工作区 + 会话列表 -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="WorkspacePanel" />
            </ScrollViewer>

            <!-- 分隔线 -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="16,8" />

            <!-- RAG 知识库 -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <ListBox Name="RagListBox"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:RagRowModel">
                            <Border Padding="6,4" CornerRadius="4" Cursor="Hand"
                                    BorderThickness="0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="📚"
                                               Margin="0,0,8,0"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Name="DeleteRagBtn"
                                            Content="🗑️"
                                            FontSize="12"
                                            Padding="4,2"
                                            Margin="4,0,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource TextTertiaryBrush}"
                                            Cursor="Hand"
                                            ToolTip.Tip="删除知识库"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- 分隔线 -->
            <Border Grid.Row="3" Height="1" Background="{DynamicResource DividerBrush}" Margin="16,8" />

            <!-- 底部项目信息 -->
            <Border Grid.Row="4" Padding="16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text=" LubanAgentCodex"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="v1.0.0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- GitHub 仓库链接：点击在默认浏览器打开 -->
                    <Button Name="GitHubBtn"
                            Content="GitHub ↗"
                            FontSize="11"
                            Padding="0"
                            Margin="0,0,0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Cursor="Hand"
                            ToolTip.Tip="在浏览器中打开 GitHub 仓库" />
                    <TextBlock Text="Author: yswenli"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="yswenli@outlook.com"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="© 2026 All Rights Reserved"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <!-- 工作区设置中心入口：编辑当前/其它工作区及用户级 .luban-agent 的 skills/rules/mcps -->
                    <Button Name="SettingsBtn"
                            Content="⚙ 设置"
                            FontSize="12"
                            Padding="8,6"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            ToolTip.Tip="工作区设置（技能 / 规则 / MCP）" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
