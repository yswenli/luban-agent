<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LubanAgentCodex.Views.NewWorkspaceDialog"
        Title="新建工作区"
        Width="460"
        Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="24,20" RowSpacing="14">

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="➕" FontSize="18" Foreground="#06B6D4" VerticalAlignment="Center" />
            <TextBlock Text="新建工作区"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 名称 -->
        <TextBox Grid.Row="1"
                 Name="NameTextBox"
                 PlaceholderText="工作区名称（默认取目录名）"
                 FontSize="14"
                 Background="{DynamicResource SidebarBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" />

        <!-- 路径 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Name="PathTextBox"
                     PlaceholderText="选择工作区目录"
                     IsReadOnly="True"
                     FontSize="14"
                     Background="{DynamicResource SidebarBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
            <Button Grid.Column="1"
                    Name="BrowseButton"
                    Content="浏览"
                    MinWidth="72"
                    FontSize="13"
                    Background="{DynamicResource CardBrush}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="6"
                    Cursor="Hand" />
        </Grid>

        <!-- 错误提示 -->
        <TextBlock Grid.Row="3"
                   Name="ErrorText"
                   Foreground="#F44336"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="False" />

        <!-- 按钮区 -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="OkButton"
                    Content="创建"
                    MinWidth="80"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White"
                    CornerRadius="6"
                    Cursor="Hand" />
            <Button Name="CancelButton"
                    Content="取消"
                    MinWidth="80"
                    Background="{DynamicResource CardBrush}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    CornerRadius="6"
                    Cursor="Hand" />
        </StackPanel>

    </Grid>

</Window>
