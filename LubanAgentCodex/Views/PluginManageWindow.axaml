<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LubanAgentCodex.Views"
        x:Class="LubanAgentCodex.Views.PluginManageWindow"
        Title="插件管理"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🧩 插件管理"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Name="RootPathText"
                       FontSize="11"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 插件列表 -->
        <ListBox Grid.Row="1"
                 Name="PluginList"
                 Background="{DynamicResource SidebarBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 CornerRadius="8">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="local:PluginRowModel">
                    <Border Padding="12,8" Margin="4,2" CornerRadius="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding Version}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Border Background="{Binding StateBrush}"
                                            CornerRadius="8"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="10"
                                                   Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="{Binding Badge}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastError}"
                                           Foreground="#E57373"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasError}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="2"
                   Name="StatusText"
                   FontSize="11"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" />

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Name="RefreshBtn" Content="刷新" MinWidth="72" />
            <Button Name="InstallBtn" Content="安装…" MinWidth="72" />
            <Button Name="EnableBtn" Content="启用" MinWidth="72" />
            <Button Name="DisableBtn" Content="停用" MinWidth="72" />
            <Button Name="UpgradeBtn" Content="升级…" MinWidth="72" />
            <Button Name="UninstallBtn" Content="卸载" MinWidth="72" />
            <Button Name="CloseBtn"
                    Content="关闭"
                    MinWidth="80"
                    HorizontalAlignment="Right"
                    Margin="24,0,0,0" />
        </StackPanel>

    </Grid>

</Window>